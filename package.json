    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "essentia.js": "^0.1.3",
    "meyda": "^5.6.3",
